{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "b71c0fcb3f0c",
  "duracion": 42.09,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Tus dedos no se arrugan por el agua.",
      "escena": "hook",
      "clave": "por el agua",
      "inicio": 0,
      "fin": 2.32,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Si fuera la piel empapándose, se te arrugaría también el brazo, y solo se arrugan las yemas.",
      "escena": "brazo",
      "clave": "yemas",
      "inicio": 2.4,
      "fin": 7.68,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Y lo más raro: si el nervio de un dedo está roto, ese dedo sale de la bañera liso.",
      "escena": "nervio",
      "clave": "liso",
      "inicio": 7.72,
      "fin": 13.06,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Así que no es el agua: es tu sistema nervioso, y lo hace a propósito.",
      "escena": "nervio",
      "clave": "a propósito",
      "inicio": 13.14,
      "fin": 18.26,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Al notar el agua, los nervios aprietan los vasos de sangre de la yema.",
      "escena": "dentro",
      "clave": "vasos",
      "inicio": 18.3,
      "fin": 21.7,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Entra menos sangre, la yema se deshincha y la piel que sobra se pliega en surcos.",
      "escena": "dentro",
      "clave": "surcos",
      "inicio": 21.88,
      "fin": 26.78,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "¿Y para qué? Como un neumático de lluvia: sus surcos echan el agua para no patinar.",
      "escena": "rueda",
      "clave": "neumático",
      "inicio": 26.807,
      "fin": 31.92,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "En un experimento, con los dedos arrugados, la gente pasaba canicas mojadas de un bote a otro un 12 % más rápido.",
      "escena": "canicas",
      "clave": "12 %",
      "inicio": 31.96,
      "fin": 39.44,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "No es por el agua: es para el agua.",
      "escena": "cierre",
      "clave": "para el agua",
      "inicio": 39.52,
      "fin": 41.94,
      "ritmo": 1
    }
  ],
