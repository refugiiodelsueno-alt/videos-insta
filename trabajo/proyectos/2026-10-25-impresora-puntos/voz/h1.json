  "firma": "25669d0fa40e",
  "duracion": 54.76,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Las hojas que imprimes en el trabajo llevan un mensaje escondido.",
      "escena": "hook",
      "clave": "escondido",
      "inicio": 0,
      "fin": 3.8,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Y no lo ves porque está escrito en amarillo, con puntitos que a simple vista no se distinguen.",
      "escena": "hook",
      "clave": "amarillo",
      "inicio": 3.98,
      "fin": 9.02,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Pero si iluminas la hoja con luz azul, aparecen cientos, en una cuadrícula que se repite por toda la página.",
      "escena": "luz-azul",
      "clave": "luz azul",
      "inicio": 9.2,
      "fin": 15.76,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Cada punto es un uno, y cada hueco, un cero.",
      "escena": "codigo",
      "clave": "uno",
      "inicio": 15.94,
      "fin": 18.9,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Y juntos dicen el número de serie de la impresora y, en muchas, el día y la hora exactos.",
      "escena": "codigo",
      "clave": "número de serie",
      "inicio": 19.08,
      "fin": 24.76,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Lo hacen muchas impresoras láser a color, y las marcas no te lo cuentan.",
      "escena": "impresora",
      "clave": "láser",
      "inicio": 24.94,
      "fin": 28.62,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "¿Para qué? Para que nadie pueda imprimir billetes falsos sin dejar rastro.",
      "escena": "billete",
      "clave": "billetes",
      "inicio": 28.8,
      "fin": 33.12,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "En 2017 se filtró a la prensa un documento secreto de Estados Unidos, y en la copia publicada estaban los puntos.",
      "escena": "filtracion",
      "clave": "secreto",
      "inicio": 33.3,
      "fin": 40.52,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Decían la impresora, el día, 9 de mayo, y la hora: 6:20.",
      "escena": "filtracion",
      "clave": "6:20",
      "inicio": 40.6,
      "fin": 46.2,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Así que esa hoja que dejaste en la impresora no es anónima: lleva tu hora firmada.",
      "escena": "cierre",
      "clave": "firmada",
      "inicio": 46.28,
      "fin": 51.48,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Envíaselo a ese compañero que lo imprime todo.",
      "escena": "cierre",
      "clave": "Envíaselo",
      "inicio": 51.6,
      "fin": 53.96,
      "ritmo": 1
    }
  ],
