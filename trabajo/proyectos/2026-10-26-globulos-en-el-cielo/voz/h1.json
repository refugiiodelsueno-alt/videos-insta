{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "79fa2c99ce94",
  "duracion": 50.89,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Esos puntitos de luz que ves en el cielo azul son tus glóbulos blancos.",
      "escena": "hook",
      "clave": "glóbulos blancos",
      "inicio": 0,
      "fin": 4.56,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "No son moscas volantes: es tu sangre, moviéndose dentro de tu ojo.",
      "escena": "ojo",
      "clave": "tu sangre",
      "inicio": 4.64,
      "fin": 9.28,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Antes de llegar al fondo del ojo, la luz tiene que cruzar una red de vasitos de sangre.",
      "escena": "retina",
      "clave": "vasitos",
      "inicio": 9.46,
      "fin": 14.42,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "No la ves porque tu cerebro la borra: siempre está en el mismo sitio.",
      "escena": "sombra",
      "clave": "la borra",
      "inicio": 14.46,
      "fin": 18.98,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Por dentro van los glóbulos rojos, en fila, y se tragan la luz azul.",
      "escena": "capilar",
      "clave": "se tragan",
      "inicio": 19.06,
      "fin": 23.7,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Pero a veces pasa un glóbulo blanco, más grande y más lento, que aparta a los rojos.",
      "escena": "capilar",
      "clave": "glóbulo blanco",
      "inicio": 23.753,
      "fin": 29.14,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Por ese hueco se cuela la luz azul, y en tu ojo se enciende un puntito.",
      "escena": "capilar",
      "clave": "un puntito",
      "inicio": 29.18,
      "fin": 33.94,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Y como se mueve, tu cerebro no lo puede borrar.",
      "escena": "cielo",
      "clave": "no lo puede borrar",
      "inicio": 33.98,
      "fin": 37.06,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Van a saltitos, más rápido con cada latido de tu corazón.",
      "escena": "cielo",
      "clave": "cada latido",
      "inicio": 37.1,
      "fin": 40.82,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Y justo donde miras no hay ninguno: ahí no hay vasos, para que veas nítido.",
      "escena": "centro",
      "clave": "no hay ninguno",
      "inicio": 40.9,
      "fin": 45.62,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Así que cada vez que miras el cielo azul, lo estás mirando a través de tu propia sangre.",
      "escena": "cierre",
      "clave": "tu propia sangre",
      "inicio": 45.7,
      "fin": 50.74,
      "ritmo": 1
    }
  ],
