{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "a8a8fcfa0b5b",
  "duracion": 48.53,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "La voz que odias en tus audios es tu voz de verdad.",
      "escena": "hook",
      "clave": "de verdad",
      "inicio": 0,
      "fin": 3.36,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "No es que el móvil grabe mal: así te oyen todos.",
      "escena": "hook",
      "clave": "todos",
      "inicio": 3.44,
      "fin": 6.56,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "La que suena rara es la que oyes tú, porque te llega por dos caminos.",
      "escena": "cabeza",
      "clave": "dos caminos",
      "inicio": 6.74,
      "fin": 10.98,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Uno va por fuera: sale de tu boca, cruza el aire y entra por la oreja.",
      "escena": "cabeza",
      "clave": "aire",
      "inicio": 11.1,
      "fin": 15.8,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "El otro va por dentro: al hablar, vibran los huesos de tu cabeza y la llevan directa al oído.",
      "escena": "craneo",
      "clave": "huesos",
      "inicio": 15.88,
      "fin": 21.72,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Y el hueso deja pasar mejor los graves, así que por dentro suenas más grave y más lleno.",
      "escena": "craneo",
      "clave": "graves",
      "inicio": 21.76,
      "fin": 27.32,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "El micro solo oye el aire, así que en el audio te faltan esos graves y suenas más fino.",
      "escena": "micro",
      "clave": "fino",
      "inicio": 27.4,
      "fin": 32.82,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Tápate los oídos y habla: casi todo te llega por el hueso, y suenas aún más grave.",
      "escena": "tapado",
      "clave": "más grave",
      "inicio": 32.86,
      "fin": 38.42,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "En un experimento, la gente puntuó su voz grabada mejor que la de los demás, sin saber que era la suya.",
      "escena": "experimento",
      "clave": "la suya",
      "inicio": 38.5,
      "fin": 44.28,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Así que la voz rara no es la del audio: es la que oyes tú.",
      "escena": "cierre",
      "clave": "tú",
      "inicio": 44.36,
      "fin": 48.38,
      "ritmo": 1
    }
  ],
