{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "bb7eb53445ad",
  "duracion": 41.73,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Lloras al cortar cebolla porque la cebolla te está disparando.",
      "escena": "hook",
      "clave": "disparando",
      "inicio": 0,
      "fin": 3.36,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Entera no tiene nada que haga llorar: el arma la fabrica en cuanto la cortas.",
      "escena": "hook",
      "clave": "fabrica",
      "inicio": 3.54,
      "fin": 8.02,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Cada célula guarda por separado un compuesto de azufre y una enzima, y el cuchillo, al romperla, los mezcla.",
      "escena": "celula",
      "clave": "los mezcla",
      "inicio": 8.2,
      "fin": 14.36,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "En segundos fabrican un gas que antes no existía, y sube hasta tus ojos.",
      "escena": "celula",
      "clave": "un gas",
      "inicio": 14.54,
      "fin": 18.84,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Unos nervios del ojo lo detectan, y tu cuerpo suelta lágrimas para lavarlo.",
      "escena": "ojo",
      "clave": "lágrimas",
      "inicio": 19.02,
      "fin": 23.08,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "En Cornell lo grabaron a cámara superlenta: cada corte lanza una nube de gotitas que sube hasta 60 centímetros.",
      "escena": "camara",
      "clave": "60 centímetros",
      "inicio": 23.26,
      "fin": 30.7,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Y las que más salen, y más rápido, son con un cuchillo sin filo y cortando deprisa.",
      "escena": "cuchillos",
      "clave": "sin filo",
      "inicio": 30.74,
      "fin": 35.9,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Así que afila el cuchillo y corta despacio: así la cebolla casi no puede dispararte.",
      "escena": "cierre",
      "clave": "despacio",
      "inicio": 35.98,
      "fin": 41.58,
      "ritmo": 1
    }
  ],
