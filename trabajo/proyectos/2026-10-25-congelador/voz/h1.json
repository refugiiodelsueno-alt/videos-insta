{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "128242d3a23b",
  "duracion": 49.45,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Cierras el congelador, lo intentas abrir otra vez y no se abre.",
      "escena": "hook",
      "clave": "no se abre",
      "inicio": 0,
      "fin": 4.4,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Y no es la goma ni el hielo: algo empuja la puerta desde fuera.",
      "escena": "hook",
      "clave": "desde fuera",
      "inicio": 4.44,
      "fin": 8.16,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Cuando abres, entra el aire de tu cocina, que está caliente.",
      "escena": "aire",
      "clave": "caliente",
      "inicio": 8.34,
      "fin": 11.46,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Ese aire son moléculas que van más rápido que una bala y chocan sin parar contra todo.",
      "escena": "aire",
      "clave": "bala",
      "inicio": 11.64,
      "fin": 16.36,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Al cerrar, el frío las frena en segundos, así que dentro chocan menos y empujan menos.",
      "escena": "aire",
      "clave": "frena",
      "inicio": 16.54,
      "fin": 21.58,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Pero fuera, las de tu cocina siguen chocando igual de fuerte contra la puerta.",
      "escena": "fuerza",
      "clave": "fuera",
      "inicio": 21.76,
      "fin": 25.68,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Basta con que dentro empujen un uno por ciento menos para que la puerta tenga encima unos cuarenta kilos.",
      "escena": "fuerza",
      "clave": "cuarenta kilos",
      "inicio": 25.86,
      "fin": 31.94,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Y si la cierras de golpe, peor: echas aire fuera y dentro queda todavía menos.",
      "escena": "fuerza",
      "clave": "de golpe",
      "inicio": 31.98,
      "fin": 37.14,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Por eso, si esperas un minuto, se abre sin esfuerzo: por la goma se cuela aire hasta que dentro empuja igual que fuera.",
      "escena": "junta",
      "clave": "un minuto",
      "inicio": 37.22,
      "fin": 44.34,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "La puerta no la sujeta el frío: la sujeta el aire de tu cocina, y por eso...",
      "escena": "cierre",
      "clave": "aire",
      "inicio": 44.38,
      "fin": 49.3,
      "ritmo": 1
    }
  ],
