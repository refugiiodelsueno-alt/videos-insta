  "firma": "c9989fffcc02",
  "duracion": 56.81,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Tu wifi va más lento cada vez que calientas la leche.",
      "escena": "hook",
      "clave": "wifi",
      "inicio": 0,
      "fin": 2.96,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "No es tu router, ni casualidad: el microondas y el wifi usan casi la misma onda.",
      "escena": "ondas",
      "clave": "misma onda",
      "inicio": 3.14,
      "fin": 8.24,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Una onda que mide unos doce centímetros de punta a punta.",
      "escena": "ondas",
      "clave": "doce centímetros",
      "inicio": 8.42,
      "fin": 11.54,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Por eso la puerta del microondas lleva esa rejilla de agujeritos.",
      "escena": "rejilla",
      "clave": "rejilla",
      "inicio": 11.72,
      "fin": 15.32,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Cada agujero mide un par de milímetros, así que la onda no cabe y rebota hacia dentro.",
      "escena": "rejilla",
      "clave": "rebota",
      "inicio": 15.5,
      "fin": 20.46,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "La luz, en cambio, es diminuta y pasa sin problema: por eso ves girar tu taza.",
      "escena": "rejilla",
      "clave": "luz",
      "inicio": 20.64,
      "fin": 25.36,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Pero el microondas empuja con miles de veces más fuerza que tu router.",
      "escena": "potencia",
      "clave": "miles",
      "inicio": 25.54,
      "fin": 29.44,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Así que basta con que se escape una pizca por la puerta para tapar la señal del wifi.",
      "escena": "potencia",
      "clave": "pizca",
      "inicio": 29.62,
      "fin": 34.42,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "¿Y por qué comparten onda? Casi todo el mundo cree que es la que mejor calienta el agua, y no es verdad.",
      "escena": "mito",
      "clave": "agua",
      "inicio": 34.6,
      "fin": 39.98,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Esa onda se reservó para aparatos que calientan, y nadie la quería para comunicarse, por todo el ruido que meten.",
      "escena": "banda",
      "clave": "ruido",
      "inicio": 40.16,
      "fin": 46.52,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Hasta que en 1985 Estados Unidos dejó usarla sin licencia, y de ahí salió el wifi.",
      "escena": "banda",
      "clave": "sin licencia",
      "inicio": 46.7,
      "fin": 52.66,
      "ritmo": 1
    },
    {
      "n": 12,
      "parte": "cuerpo",
      "texto": "Tu wifi vive en la onda que le sobraba al microondas, y por eso...",
      "escena": "cierre",
      "clave": "sobraba",
      "inicio": 52.84,
      "fin": 56.66,
      "ritmo": 1
    }
  ],
