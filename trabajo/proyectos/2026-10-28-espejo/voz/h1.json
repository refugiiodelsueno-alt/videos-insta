{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "059a3e96f27f",
  "duracion": 49.59,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Tu espejo no te cambia la izquierda por la derecha.",
      "escena": "hook",
      "clave": "derecha",
      "inicio": 0,
      "fin": 2.88,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Si lo hiciera, ¿por qué no te pone también la cabeza abajo?",
      "escena": "hook",
      "clave": "abajo",
      "inicio": 2.92,
      "fin": 6.32,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Haz la prueba: levanta la mano derecha.",
      "escena": "prueba",
      "clave": "derecha",
      "inicio": 6.4,
      "fin": 8.72,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "La del espejo se levanta en el mismo lado, no en el otro.",
      "escena": "prueba",
      "clave": "mismo",
      "inicio": 8.9,
      "fin": 12.1,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Arriba sigue arriba, y la derecha sigue a la derecha.",
      "escena": "prueba",
      "clave": "arriba",
      "inicio": 12.18,
      "fin": 15.62,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Lo único que da la vuelta es delante y detrás:",
      "escena": "planta",
      "clave": "detrás",
      "inicio": 15.7,
      "fin": 18.58,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "tú miras hacia el espejo, y tu reflejo mira hacia ti.",
      "escena": "planta",
      "clave": "ti",
      "inicio": 18.62,
      "fin": 22.26,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Entonces, ¿de dónde sale lo de la izquierda y la derecha?",
      "escena": "planta",
      "clave": "sale",
      "inicio": 22.38,
      "fin": 25.86,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "De tu cabeza: para ponerte en su sitio, te imaginas dándote la vuelta de lado.",
      "escena": "giro",
      "clave": "lado",
      "inicio": 25.94,
      "fin": 30.82,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Y al girar así, tu mano derecha acaba en el otro lado.",
      "escena": "giro",
      "clave": "otro",
      "inicio": 30.86,
      "fin": 34.18,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Si te imaginaras girando como al hacer el pino, te parecería que el espejo te pone la cabeza abajo.",
      "escena": "pino",
      "clave": "pino",
      "inicio": 34.22,
      "fin": 39.92,
      "ritmo": 1
    },
    {
      "n": 12,
      "parte": "cuerpo",
      "texto": "Las ambulancias lo aprovechan: llevan el nombre escrito al revés,",
      "escena": "ambulancia",
      "clave": "revés",
      "inicio": 40,
      "fin": 43.52,
      "ritmo": 1
    },
    {
      "n": 13,
      "parte": "cuerpo",
      "texto": "y en el retrovisor del coche de delante se lee al derecho.",
      "escena": "ambulancia",
      "clave": "retrovisor",
      "inicio": 43.56,
      "fin": 46.88,
      "ritmo": 1
    },
    {
      "n": 14,
      "parte": "cuerpo",
      "texto": "Así que, aunque lo parezca, acuérdate:",
      "escena": "cierre",
      "clave": "acuérdate",
      "inicio": 46.96,
      "fin": 49.44,
      "ritmo": 1
    }
  ],
