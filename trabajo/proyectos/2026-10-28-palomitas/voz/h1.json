{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "a6d051d4286f",
  "duracion": 54.35,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "El «pop» de las palomitas no es el grano rompiéndose.",
      "escena": "hook",
      "clave": "pop",
      "inicio": 0,
      "fin": 3.36,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "El grano se abre primero, y el ruido llega una décima de segundo después.",
      "escena": "lento",
      "clave": "después",
      "inicio": 3.54,
      "fin": 8.18,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Todo empieza con una gota de agua, encerrada en una cáscara que no deja escapar nada.",
      "escena": "dentro",
      "clave": "gota de agua",
      "inicio": 8.36,
      "fin": 13.36,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Con el calor, esa agua se convierte en vapor y aprieta como una olla a presión: unas nueve veces más que el aire de fuera.",
      "escena": "dentro",
      "clave": "olla a presión",
      "inicio": 13.54,
      "fin": 21.3,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "A unos 180 grados, la cáscara ya no aguanta y se raja.",
      "escena": "dentro",
      "clave": "se raja",
      "inicio": 21.34,
      "fin": 25.56,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "El almidón de dentro, blando por el calor, se hincha de golpe como una espuma, y al enfriarse se queda duro.",
      "escena": "espuma",
      "clave": "espuma",
      "inicio": 25.6,
      "fin": 32.12,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Y para saltar, le sale una patita de almidón que empuja contra la olla, como un gimnasta haciendo una voltereta.",
      "escena": "salto",
      "clave": "patita",
      "inicio": 32.16,
      "fin": 38.52,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "El ruido llega justo después: el vapor escapa de golpe por la grieta, como al descorchar una botella.",
      "escena": "ruido",
      "clave": "vapor",
      "inicio": 38.6,
      "fin": 44.68,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Por eso los granos que se quedan sin abrir tienen la cáscara dañada: el vapor se les escapa antes de tiempo.",
      "escena": "duros",
      "clave": "dañada",
      "inicio": 44.76,
      "fin": 50.84,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Así que la próxima vez que las oigas en la olla, acuérdate:",
      "escena": "cierre",
      "clave": "acuérdate",
      "inicio": 50.92,
      "fin": 54.2,
      "ritmo": 1
    }
  ],
