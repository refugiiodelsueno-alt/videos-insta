{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "3c771831361a",
  "duracion": 51.21,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "La piel de gallina es tu cuerpo intentando ponerte un abrigo que ya no tienes.",
      "escena": "hook",
      "clave": "abrigo",
      "inicio": 0,
      "fin": 4.64,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Debajo de cada pelo tienes un músculo diminuto.",
      "escena": "musculo",
      "clave": "diminuto",
      "inicio": 4.72,
      "fin": 7.68,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Con frío, se encoge y pone el pelo de pie,",
      "escena": "musculo",
      "clave": "pie",
      "inicio": 7.76,
      "fin": 10.48,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "y la piel de alrededor sube en un bultito: eso es la piel de gallina.",
      "escena": "musculo",
      "clave": "bultito",
      "inicio": 10.52,
      "fin": 15.14,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "En un animal con pelo, eso sirve: los pelos de pie atrapan aire, y el aire guarda el calor.",
      "escena": "abrigo",
      "clave": "aire",
      "inicio": 15.22,
      "fin": 20.74,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Es como inflar un plumas.",
      "escena": "abrigo",
      "clave": "plumas",
      "inicio": 20.78,
      "fin": 22.5,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Tus antepasados tenían ese abrigo; tú perdiste casi todo el pelo, pero no los músculos.",
      "escena": "antepasado",
      "clave": "músculos",
      "inicio": 22.553,
      "fin": 28.42,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Por eso también te pasa con miedo:",
      "escena": "miedo",
      "clave": "miedo",
      "inicio": 28.46,
      "fin": 30.5,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "un gato asustado se eriza entero para parecer más grande.",
      "escena": "miedo",
      "clave": "grande",
      "inicio": 30.54,
      "fin": 34.02,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Y el mismo nervio de alarma te eriza a ti con un susto, o con una canción que te emociona.",
      "escena": "miedo",
      "clave": "canción",
      "inicio": 34.047,
      "fin": 39.54,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Pero no es del todo inútil: en ratones, ese nervio también despierta las células que fabrican el pelo.",
      "escena": "raiz",
      "clave": "despierta",
      "inicio": 39.593,
      "fin": 45.86,
      "ritmo": 1
    },
    {
      "n": 12,
      "parte": "cuerpo",
      "texto": "Si el frío dura semanas, sale pelo nuevo.",
      "escena": "raiz",
      "clave": "nuevo",
      "inicio": 45.9,
      "fin": 48.74,
      "ritmo": 1
    },
    {
      "n": 13,
      "parte": "cuerpo",
      "texto": "Así que la próxima vez, acuérdate:",
      "escena": "cierre",
      "clave": "acuérdate",
      "inicio": 48.82,
      "fin": 51.06,
      "ritmo": 1
    }
  ],
