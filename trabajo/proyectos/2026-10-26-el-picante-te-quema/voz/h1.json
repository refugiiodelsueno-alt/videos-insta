{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "6574c7fb367c",
  "duracion": 45.41,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "El picante no te quema la boca: le está mintiendo a tu lengua.",
      "escena": "hook",
      "clave": "mintiendo",
      "inicio": 0,
      "fin": 4,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "En tu lengua hay un sensor que solo salta con calor de verdad, a más de 43 grados.",
      "escena": "sensor",
      "clave": "43 grados",
      "inicio": 4.08,
      "fin": 9.76,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "La capsaicina del chile encaja en ese sensor como una llave y lo abre sin nada de calor.",
      "escena": "llave",
      "clave": "como una llave",
      "inicio": 9.84,
      "fin": 15.36,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Tu cerebro recibe una alarma de fuego y el cuerpo se la cree: sudas, te pones rojo y lloras.",
      "escena": "alarma",
      "clave": "alarma de fuego",
      "inicio": 15.4,
      "fin": 21.68,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Encontrar ese sensor gracias al chile le dio el Nobel de 2021 a David Julius.",
      "escena": "nobel",
      "clave": "el Nobel",
      "inicio": 21.76,
      "fin": 27.1,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Y el mentol hace el mismo truco al revés: abre el sensor del frío sin que haga frío.",
      "escena": "mentol",
      "clave": "al revés",
      "inicio": 27.14,
      "fin": 32.54,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "A los pájaros la capsaicina no les pica nada: se comen el chile y siembran sus semillas enteras.",
      "escena": "pajaros",
      "clave": "no les pica",
      "inicio": 32.58,
      "fin": 38.38,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "El chile pica para espantar a los mamíferos, y aun así, en cada bocado, tu lengua se vuelve a creer que arde.",
      "escena": "cierre",
      "clave": "se vuelve a creer",
      "inicio": 38.46,
      "fin": 45.26,
      "ritmo": 1
    }
  ],
