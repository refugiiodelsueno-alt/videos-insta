{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "5b710734a0a7",
  "duracion": 54.31,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Ahora mismo hay un agujero en lo que ves, y tu cerebro te lo está tapando.",
      "escena": "hook",
      "clave": "un agujero",
      "inicio": 0,
      "fin": 4.48,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Tápate el ojo izquierdo, mira fijamente la cruz y acércate el móvil despacio.",
      "escena": "prueba",
      "clave": "la cruz",
      "inicio": 4.533,
      "fin": 9.86,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Más o menos a un palmo de la cara, el punto rojo desaparece.",
      "escena": "prueba",
      "clave": "desaparece",
      "inicio": 9.887,
      "fin": 13.26,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Y en su sitio no ves negro: ves las rayas del fondo, que se inventa tu cerebro.",
      "escena": "prueba",
      "clave": "se inventa",
      "inicio": 13.44,
      "fin": 18.64,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Es tu punto ciego: el sitio por donde el nervio óptico sale del ojo.",
      "escena": "ojo",
      "clave": "punto ciego",
      "inicio": 18.72,
      "fin": 23.36,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Ahí se juntan un millón de cables de la retina, y no queda sitio para nada que vea la luz.",
      "escena": "ojo",
      "clave": "un millón de cables",
      "inicio": 23.4,
      "fin": 28.56,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Y es enorme: en el cielo, te cabrían diez lunas llenas en fila dentro de él.",
      "escena": "cielo",
      "clave": "diez lunas",
      "inicio": 28.6,
      "fin": 33.84,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "No lo notas porque cada ojo tapa el agujero del otro.",
      "escena": "ojos",
      "clave": "el agujero del otro",
      "inicio": 33.88,
      "fin": 36.96,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Y con uno cerrado, tu cerebro rellena el hueco con lo que hay alrededor.",
      "escena": "ojos",
      "clave": "rellena el hueco",
      "inicio": 37,
      "fin": 41.36,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "El pulpo no tiene: en su ojo, los cables van por detrás de la retina.",
      "escena": "pulpo",
      "clave": "el pulpo",
      "inicio": 41.4,
      "fin": 45.84,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "En el nuestro van por delante, y tienen que atravesarla para salir.",
      "escena": "pulpo",
      "clave": "por delante",
      "inicio": 45.88,
      "fin": 49.76,
      "ritmo": 1
    },
    {
      "n": 12,
      "parte": "cuerpo",
      "texto": "Así que ahora mismo, un trozo de lo que ves te lo está inventando tu cerebro.",
      "escena": "cierre",
      "clave": "inventando",
      "inicio": 49.84,
      "fin": 54.16,
      "ritmo": 1
    }
  ],
