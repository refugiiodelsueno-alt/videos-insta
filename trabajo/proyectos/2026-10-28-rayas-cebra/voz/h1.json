  "firma": "f80af1deedce",
  "duracion": 56.13,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Las rayas de la cebra no la esconden de los leones: la protegen de las moscas.",
      "escena": "hook",
      "clave": "moscas",
      "inicio": 0,
      "fin": 5.04,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "De lejos, a los ojos de un león, las rayas se mezclan y la cebra se ve gris.",
      "escena": "leon",
      "clave": "gris",
      "inicio": 5.22,
      "fin": 10.26,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Su enemigo de verdad es mucho más pequeño: el tábano, una mosca que pica y contagia enfermedades.",
      "escena": "tabano",
      "clave": "tábano",
      "inicio": 10.3,
      "fin": 16.9,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Y el pelo de la cebra es tan corto que su picadura lo atraviesa sin problema.",
      "escena": "tabano",
      "clave": "tan corto",
      "inicio": 16.927,
      "fin": 21.72,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "En 2019 lo grabaron en una granja inglesa: los tábanos se acercaban igual a las cebras que a los caballos.",
      "escena": "granja",
      "clave": "igual",
      "inicio": 21.76,
      "fin": 28.36,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Pero sobre las cebras se posaban cuatro veces menos.",
      "escena": "granja",
      "clave": "cuatro veces menos",
      "inicio": 28.413,
      "fin": 31.48,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "No frenaban a tiempo: pasaban de largo, o chocaban y rebotaban.",
      "escena": "aterrizaje",
      "clave": "rebotaban",
      "inicio": 31.56,
      "fin": 36.04,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Luego vistieron a los caballos con una manta de rayas, y también se posaron muchas menos.",
      "escena": "pruebas",
      "clave": "manta de rayas",
      "inicio": 36.12,
      "fin": 41.4,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Y en Japón pintaron rayas a unas vacas: tenían la mitad de moscas encima.",
      "escena": "pruebas",
      "clave": "la mitad",
      "inicio": 41.44,
      "fin": 46.44,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Nadie sabe aún qué ve exactamente la mosca, pero de cerca las rayas la despistan justo al aterrizar.",
      "escena": "ojo",
      "clave": "despistan",
      "inicio": 46.493,
      "fin": 52.84,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Así que la próxima vez que veas una cebra, recuerda:",
      "escena": "cierre",
      "clave": "recuerda",
      "inicio": 52.92,
      "fin": 55.98,
      "ritmo": 1
    }
  ],
