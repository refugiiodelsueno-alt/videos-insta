{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "b68aae83223a",
  "duracion": 49.41,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Ese crac de tus dedos es una burbuja de gas que nace dentro del nudillo.",
      "escena": "hook",
      "clave": "burbuja",
      "inicio": 0,
      "fin": 4.32,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "No se rompe nada ni chocan los huesos: entre ellos hay un líquido con gas disuelto, como un refresco cerrado.",
      "escena": "junta",
      "clave": "gas disuelto",
      "inicio": 4.5,
      "fin": 10.98,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Cuando tiras del dedo, los huesos se separan, la presión cae de golpe y el gas forma una burbuja.",
      "escena": "junta",
      "clave": "la presión cae",
      "inicio": 11.16,
      "fin": 16.74,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Lo vieron en directo metiendo un dedo en una resonancia y tirando de él con un cable.",
      "escena": "resonancia",
      "clave": "resonancia",
      "inicio": 16.92,
      "fin": 21.16,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Justo en el crac, entre los huesos aparece un hueco negro: la burbuja.",
      "escena": "resonancia",
      "clave": "hueco negro",
      "inicio": 21.34,
      "fin": 25.6,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Por eso no lo puedes crujir otra vez enseguida: hay que esperar unos 20 minutos a que el gas se vuelva a disolver.",
      "escena": "espera",
      "clave": "20 minutos",
      "inicio": 25.78,
      "fin": 31.62,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "¿Y la artrosis? Un médico se crujió solo la mano izquierda durante 50 años, más de 36.000 veces.",
      "escena": "manos",
      "clave": "50 años",
      "inicio": 31.8,
      "fin": 39.42,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Al final, ninguna de sus dos manos tenía artrosis, y le dieron un Ig Nobel.",
      "escena": "manos",
      "clave": "ninguna",
      "inicio": 39.5,
      "fin": 44.22,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Así que no se te rompe nada: cada crac es un refresco que se abre dentro de tu dedo.",
      "escena": "cierre",
      "clave": "un refresco",
      "inicio": 44.26,
      "fin": 49.26,
      "ritmo": 1
    }
  ],
