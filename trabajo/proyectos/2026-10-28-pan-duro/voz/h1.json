{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "9520a726d89a",
  "duracion": 45.75,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "El pan duro no está seco.",
      "escena": "hook",
      "clave": "seco",
      "inicio": 0,
      "fin": 2.16,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Se endurece aunque no pierda agua: por eso se te pone duro también dentro de la bolsa.",
      "escena": "bolsa",
      "clave": "bolsa",
      "inicio": 2.2,
      "fin": 7.36,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "El culpable es el almidón, los granitos que forman la miga.",
      "escena": "miga",
      "clave": "almidón",
      "inicio": 7.44,
      "fin": 11.36,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "En el horno, el calor los abre y se empapan de agua, así que la miga sale blanda.",
      "escena": "horno",
      "clave": "se empapan",
      "inicio": 11.44,
      "fin": 16.56,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Pero al enfriarse, sus cadenas se vuelven a juntar en cristales duros, con el agua atrapada dentro.",
      "escena": "cristales",
      "clave": "cristales",
      "inicio": 16.613,
      "fin": 22.48,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "El agua sigue ahí, pero presa, así que la miga se nota seca y dura.",
      "escena": "cristales",
      "clave": "presa",
      "inicio": 22.52,
      "fin": 27.36,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Y el frío de la nevera lo acelera: allí se pone duro varias veces más rápido.",
      "escena": "nevera",
      "clave": "nevera",
      "inicio": 27.4,
      "fin": 32.08,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "En el congelador, en cambio, se queda como estaba.",
      "escena": "nevera",
      "clave": "congelador",
      "inicio": 32.12,
      "fin": 34.96,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Por eso al calentarlo vuelve a estar tierno: el calor deshace los cristales y suelta el agua, hasta que se enfría otra vez.",
      "escena": "tostar",
      "clave": "tierno",
      "inicio": 35.04,
      "fin": 42.4,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Así que, aunque suene como una piedra, acuérdate:",
      "escena": "cierre",
      "clave": "acuérdate",
      "inicio": 42.48,
      "fin": 45.6,
      "ritmo": 1
    }
  ],
