{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "c2bceef1f25e",
  "duracion": 48.83,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Un gato se gira en el aire sin apoyarse en nada, y eso parecía imposible.",
      "escena": "hook",
      "clave": "imposible",
      "inicio": 0,
      "fin": 5.2,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Para empezar a girar, tienes que empujar contra algo.",
      "escena": "regla",
      "clave": "empujar contra algo",
      "inicio": 5.28,
      "fin": 8.16,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Por eso, en 1894, las fotos de un gato cayendo dejaron a los científicos de París sin palabras.",
      "escena": "fotos",
      "clave": "sin palabras",
      "inicio": 8.2,
      "fin": 15.36,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "El truco es que el gato no gira entero: se dobla por la cintura y gira por mitades.",
      "escena": "truco",
      "clave": "por mitades",
      "inicio": 15.54,
      "fin": 20.74,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Primero encoge las patas de delante y gira la mitad de delante, muy rápido.",
      "escena": "truco",
      "clave": "encoge",
      "inicio": 20.92,
      "fin": 25.08,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "La de atrás, con las patas estiradas, gira un poco al revés.",
      "escena": "truco",
      "clave": "al revés",
      "inicio": 25.26,
      "fin": 28.7,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Luego cambia: encoge las de atrás y las gira hasta ponerlas debajo.",
      "escena": "truco",
      "clave": "cambia",
      "inicio": 28.88,
      "fin": 32.8,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Como una patinadora: con los brazos pegados, gira mucho más rápido.",
      "escena": "patinadora",
      "clave": "brazos pegados",
      "inicio": 32.98,
      "fin": 36.86,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Y todo en menos de medio segundo.",
      "escena": "oido",
      "clave": "medio segundo",
      "inicio": 37.04,
      "fin": 39.12,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Años después, se estudió este giro para que los astronautas se dieran la vuelta flotando.",
      "escena": "espacio",
      "clave": "astronautas",
      "inicio": 39.3,
      "fin": 43.86,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "El gato no rompe la física: la usa mejor que nadie para hacer lo imposible.",
      "escena": "cierre",
      "clave": "lo imposible",
      "inicio": 44.04,
      "fin": 48.68,
      "ritmo": 1
    }
  ],
