{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "3a21a82426ed",
  "duracion": 48.35,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Intenta hacerte cosquillas ahora mismo: no vas a poder.",
      "escena": "hook",
      "clave": "no vas a poder",
      "inicio": 0,
      "fin": 3.32,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Y no es que tu piel sea menos sensible: si otra persona te toca igual, te mueres de risa.",
      "escena": "hook",
      "clave": "otra persona",
      "inicio": 3.5,
      "fin": 8.94,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "La diferencia está en tu cabeza.",
      "escena": "cerebro",
      "clave": "tu cabeza",
      "inicio": 8.98,
      "fin": 10.94,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Cada vez que mueves la mano, tu cerebro manda una copia de la orden al cerebelo, aquí atrás.",
      "escena": "cerebro",
      "clave": "una copia",
      "inicio": 11.12,
      "fin": 15.84,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Con esa copia calcula lo que vas a sentir, antes de sentirlo.",
      "escena": "cerebro",
      "clave": "antes de sentirlo",
      "inicio": 16.02,
      "fin": 19.92,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Así que cuando llega el toque, ya lo esperaba: lo resta, y casi no lo notas.",
      "escena": "cerebro",
      "clave": "lo resta",
      "inicio": 20,
      "fin": 24.24,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Con la mano de otro no hay copia: tu cerebro no sabe ni dónde ni cuándo, y salta la alarma.",
      "escena": "cerebro",
      "clave": "salta la alarma",
      "inicio": 24.42,
      "fin": 29.54,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "En Londres lo probaron con un robot: movías una palanca con una mano y te pasaba una espuma por la otra.",
      "escena": "robot",
      "clave": "un robot",
      "inicio": 29.72,
      "fin": 35.54,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Sin retraso, apenas se notaba.",
      "escena": "robot",
      "clave": "apenas",
      "inicio": 35.62,
      "fin": 37.86,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "Pero con dos décimas de segundo de retraso, la cuenta ya no cuadraba, y volvían las cosquillas.",
      "escena": "robot",
      "clave": "dos décimas",
      "inicio": 37.913,
      "fin": 43.46,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Tu cerebro nunca se puede sorprender a sí mismo, y sin sorpresa no hay cosquillas.",
      "escena": "cierre",
      "clave": "sin sorpresa",
      "inicio": 43.54,
      "fin": 48.2,
      "ritmo": 1
    }
  ],
