{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "b9efa1b95ec1",
  "duracion": 60.07,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Lo blanco del centro de tus cubitos no es hielo: es aire que no pudo escapar.",
      "escena": "hook",
      "clave": "aire",
      "inicio": 0,
      "fin": 5.36,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "El agua lleva aire disuelto, pero el hielo casi no le deja sitio.",
      "escena": "agua",
      "clave": "aire disuelto",
      "inicio": 5.44,
      "fin": 9.68,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Así que, al congelarse, va empujando ese aire hacia el agua que queda.",
      "escena": "agua",
      "clave": "empujando",
      "inicio": 9.76,
      "fin": 13.92,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "En tu cubitera el frío entra por todos los lados a la vez, y el hielo crece de fuera hacia dentro.",
      "escena": "cubitera",
      "clave": "todos los lados",
      "inicio": 13.96,
      "fin": 19.84,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "El aire acaba acorralado en el centro, sin salida, y se queda atrapado en miles de burbujas.",
      "escena": "cubitera",
      "clave": "acorralado",
      "inicio": 19.88,
      "fin": 25.52,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Cada burbuja desvía la luz hacia cualquier lado, y por eso se ve blanco, como la nieve o la espuma.",
      "escena": "luz",
      "clave": "desvía la luz",
      "inicio": 25.56,
      "fin": 31.6,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Hervir el agua o usar agua destilada casi no sirve: el problema es por dónde entra el frío.",
      "escena": "luz",
      "clave": "por dónde entra el frío",
      "inicio": 31.653,
      "fin": 37.36,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "En los bares lo congelan desde un solo lado: desde abajo, con el agua de arriba siempre en movimiento.",
      "escena": "bar",
      "clave": "un solo lado",
      "inicio": 37.4,
      "fin": 43.2,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "El hielo crece hacia arriba, y el aire siempre tiene por dónde escapar.",
      "escena": "bar",
      "clave": "escapar",
      "inicio": 43.28,
      "fin": 47.36,
      "ritmo": 1
    },
    {
      "n": 10,
      "parte": "cuerpo",
      "texto": "En casa puedes copiarlo: una nevera de playa, sin tapa, dentro del congelador.",
      "escena": "truco",
      "clave": "sin tapa",
      "inicio": 47.44,
      "fin": 52.56,
      "ritmo": 1
    },
    {
      "n": 11,
      "parte": "cuerpo",
      "texto": "Se congela de arriba abajo, y solo cortas la parte blanca del fondo.",
      "escena": "truco",
      "clave": "la parte blanca",
      "inicio": 52.6,
      "fin": 56.72,
      "ritmo": 1
    },
    {
      "n": 12,
      "parte": "cuerpo",
      "texto": "Así que la próxima vez que mires un cubito, recuerda:",
      "escena": "cierre",
      "clave": "recuerda",
      "inicio": 56.8,
      "fin": 59.92,
      "ritmo": 1
    }
  ],
