{
  "proveedor": "elevenlabs",
  "toma": "seguida",
  "firma": "3d2fae2b2849",
  "duracion": 49.71,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Las hormigas que notas cuando se te duerme el pie no vienen de tu pie.",
      "escena": "hook",
      "clave": "no vienen de tu pie",
      "inicio": 0,
      "fin": 4.16,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Nacen más arriba, en un trozo de nervio que tú mismo has aplastado.",
      "escena": "hook",
      "clave": "aplastado",
      "inicio": 4.2,
      "fin": 8.72,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Por la pierna baja un nervio: miles de fibras que le cuentan al cerebro lo que toca tu pie.",
      "escena": "nervio",
      "clave": "miles de fibras",
      "inicio": 8.8,
      "fin": 14.32,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "Si te sientas encima, lo aplastas y le cortas parte de la sangre.",
      "escena": "nervio",
      "clave": "la sangre",
      "inicio": 14.36,
      "fin": 18.4,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Sin oxígeno, las fibras se callan, y el pie deja de dar noticias: se ha dormido.",
      "escena": "nervio",
      "clave": "se callan",
      "inicio": 18.48,
      "fin": 24,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Lo raro llega cuando vuelve la sangre: el trozo aplastado aún no se ha recuperado, y sus fibras disparan solas, sin que nada las toque.",
      "escena": "despierta",
      "clave": "disparan solas",
      "inicio": 24.18,
      "fin": 32.58,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Tu cerebro recibe un aluvión de avisos falsos y los coloca en el pie.",
      "escena": "despierta",
      "clave": "avisos falsos",
      "inicio": 32.66,
      "fin": 37.08,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "En 1980 lo escucharon con una aguja metida en un nervio: hasta trescientos disparos por segundo, nacidos en el nervio, no en la piel.",
      "escena": "aguja",
      "clave": "trescientos",
      "inicio": 37.12,
      "fin": 46.2,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Es tu nervio despertándose. Así que ya lo sabes:",
      "escena": "cierre",
      "clave": "despertándose",
      "inicio": 46.28,
      "fin": 49.56,
      "ritmo": 1
    }
  ],
