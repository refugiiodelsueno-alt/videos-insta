  "duracion": 45.35,
  "frases": [
    {
      "n": 1,
      "parte": "hook",
      "texto": "Ese pinchazo en la frente al comer helado no viene de tu frente.",
      "escena": "hook",
      "clave": "no viene",
      "inicio": 0,
      "fin": 3.92,
      "ritmo": 1
    },
    {
      "n": 2,
      "parte": "cuerpo",
      "texto": "Ni se te congela el cerebro: todo empieza en el techo de tu boca.",
      "escena": "hook",
      "clave": "techo",
      "inicio": 3.96,
      "fin": 8.24,
      "ritmo": 1
    },
    {
      "n": 3,
      "parte": "cuerpo",
      "texto": "Cuando el helado toca el paladar, el frío cierra sus vasos de sangre, y justo después se abren de golpe.",
      "escena": "boca",
      "clave": "de golpe",
      "inicio": 8.28,
      "fin": 14.62,
      "ritmo": 1
    },
    {
      "n": 4,
      "parte": "cuerpo",
      "texto": "En Harvard lo midieron: justo cuando duele, una arteria de detrás de la frente se ensancha y entra más sangre.",
      "escena": "arteria",
      "clave": "se ensancha",
      "inicio": 14.8,
      "fin": 21.04,
      "ritmo": 1
    },
    {
      "n": 5,
      "parte": "cuerpo",
      "texto": "Y en cuanto vuelve a estrecharse, el dolor se va.",
      "escena": "arteria",
      "clave": "se va",
      "inicio": 21.22,
      "fin": 23.54,
      "ritmo": 1
    },
    {
      "n": 6,
      "parte": "cuerpo",
      "texto": "Por eso se pasa antes si pegas la lengua al paladar: lo calientas.",
      "escena": "lengua",
      "clave": "lengua",
      "inicio": 23.72,
      "fin": 27.24,
      "ritmo": 1
    },
    {
      "n": 7,
      "parte": "cuerpo",
      "texto": "Y en un colegio lo probaron: a los que se comían el helado en 5 segundos les dolió el doble que a los que tardaban medio minuto.",
      "escena": "experimento",
      "clave": "el doble",
      "inicio": 27.42,
      "fin": 34.46,
      "ritmo": 1
    },
    {
      "n": 8,
      "parte": "cuerpo",
      "texto": "Pero ¿por qué en la frente? Porque el aviso lo lleva un nervio que recoge lo que sientes en toda la cara.",
      "escena": "nervio",
      "clave": "nervio",
      "inicio": 34.54,
      "fin": 40.8,
      "ritmo": 1
    },
    {
      "n": 9,
      "parte": "cuerpo",
      "texto": "Así que el dolor nace en tu boca, pero tu cerebro lo pone en la frente.",
      "escena": "cierre",
      "clave": "frente",
      "inicio": 40.88,
      "fin": 45.2,
      "ritmo": 1
    }
  ],
